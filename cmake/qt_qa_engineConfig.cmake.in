include(CMakeFindDependencyMacro)

@PACKAGE_INIT@

# Qt major version and the component list are taken from the build that produced
# this file, so the same template serves both Qt5 and Qt6 installations.
find_dependency(@QT@ "@REQUIRED_QT_VERSION@" COMPONENTS @QA_ENGINE_QT_COMPONENTS@)

include("${CMAKE_CURRENT_LIST_DIR}/@TARGETS_EXPORT_NAME@.cmake")
check_required_components("@PROJECT_NAME@")
