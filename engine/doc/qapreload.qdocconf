project         = SailfishTest
description     = SailfishTest QML Plugin Testing Framework Reference Documentation
versionsym      =
version         = 1.0
url             = NDA

sourcedirs += src ../src

qhp.projects = SailfishTestPlugin

qhp.SailfishTestPlugin.file = qapreload.qhp
qhp.SailfishTestPlugin.namespace = ru.qaengine.sailfishtest.1.0
qhp.SailfishTestPlugin.virtualFolder = qapreload
qhp.SailfishTestPlugin.indexTitle = SailfishTest
qhp.SailfishTestPlugin.indexRoot =

qhp.SailfishTestPlugin.filterAttributes = ru.qaengine.sailfishtest 1.0

qhp.SailfishTestPlugin.subprojects = manual qmltypes
qhp.SailfishTestPlugin.subprojects.manual.type = manual
qhp.SailfishTestPlugin.subprojects.manual.indexTitle = SailfishTest
qhp.SailfishTestPlugin.subprojects.qmltypes.title = QML Types
qhp.SailfishTestPlugin.subprojects.qmltypes.indexTitle = SailfishTest
qhp.SailfishTestPlugin.subprojects.qmltypes.selectors = qmlclass
qhp.SailfishTestPlugin.subprojects.qmltypes.sortPages = true


navigation.homepage = "SailfishTest"
